# Copy to deploy/.env and fill in at least APP_BASE_URL.
# Secrets stay empty here. Never commit deploy/.env.

APP_VERSION=
APP_PORT=8080
APP_BASE_URL=
LISTEN_ADDR=:8080
DATA_DIR=/data
DB_PATH=
LOG_LEVEL=info
LOG_FORMAT=json
DEFAULT_LOCALE=de
TZ_DEFAULT=Europe/Berlin
TRUSTED_PROXIES=
COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT=168h
SESSION_LIFETIME=720h

INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD_FILE=

AUTH_PASSWORD_ENABLED=true
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_THREADS=4

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
OIDC_SCOPES=openid profile email groups
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
OIDC_ALLOWED_GROUP=
OIDC_ALLOW_EMAIL_LINKING=false
OIDC_BUTTON_LABEL=Mit SSO anmelden
OIDC_AUTO_REDIRECT=false

HEADER_AUTH_ENABLED=false
HEADER_AUTH_USER_HEADER=Remote-User
HEADER_AUTH_EMAIL_HEADER=Remote-Email
HEADER_AUTH_NAME_HEADER=Remote-Name
HEADER_AUTH_GROUPS_HEADER=Remote-Groups
HEADER_AUTH_ADMIN_GROUP=
HEADER_AUTH_ALLOWED_GROUP=
HEADER_AUTH_LOGOUT_URL=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SECRET_ACCESS_KEY_FILE=
S3_USE_PATH_STYLE=false
S3_DATA_LOCATION=
S3_ALLOW_NON_EU=false

UPLOAD_MAX_BYTES=26214400
BELEG_FORMAT=avif
BELEG_AVIF_QUALITY=40
BELEG_AVIF_SPEED=6
BELEG_WEBP_QUALITY=55
BELEG_JPEG_QUALITY=70
BELEG_ERFASSUNG_KARENZ=720h

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_MODEL=
AI_TIMEOUT=60s
AI_MAX_CONCURRENCY=2
AI_MAX_IMAGE_PX=2480
AI_RESPONSE_FORMAT=auto

FX_ECB_URL=https://data-api.ecb.europa.eu/service/data/EXR
FX_TIMEOUT=10s

TYPST_PATH=/usr/local/bin/typst
EXPORT_TIMEOUT=120s
EXPORT_PDF_STANDARD=a-3b

RATE_LIMIT_LOGIN=5/m
RATE_LIMIT_API=300/m
RATE_LIMIT_UPLOAD=30/m
RATE_LIMIT_AI=20/m

JOB_WORKERS=2
RETENTION_REPORT_ENABLED=true

# Used only with docker-compose.backup.yml. Leave empty unless you enable Litestream.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_REPLICA_URL=
